{
	"name": "uma-machine",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"module": "src/index.ts",
	"bin": {
		"uma": "./src/index.ts"
	},
	"scripts": {
		"build": "bun build --compile src/index.ts --outfile dist/uma-machine",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run scripts/db-migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"docs:wire": "bun run scripts/generate-wire-schema.ts",
		"roundtrip": "bun run scripts/machine.roundtrip.ts",
		"server": "bun run server-central/src/index.ts",
		"start": "bun run src/index.ts",
		"test": "bun test"
	},
	"dependencies": {
		"@biomejs/biome": "^2.5.12",
		"cac": "^7.0.0",
		"cli-table3": "~0.6.5",
		"drizzle-orm": "^0.45.2",
		"env-paths": "4.0.0",
		"es-toolkit": "1.52.0",
		"fast-redact": "3.5.0",
		"microsandbox": "^0.6.18",
		"ms": "2.1.3",
		"nanoid": "^6.0.1",
		"p-retry": "^8.0.1",
		"picocolors": "^1.1.1",
		"semver": "^7.8.5",
		"write-file-atomic": "8.0.0",
		"zod": "^4.6.1",
		"zod-validation-error": "5.0.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/env-paths": "2.1.2",
		"@types/fast-redact": "3.0.4",
		"@types/ms": "2.1.0",
		"@types/semver": "^7.8.0",
		"@types/write-file-atomic": "4.0.3",
		"drizzle-kit": "^0.31.10",
		"zod-to-json-schema": "^3.25.2"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	}
}
