---
import Layout from "@/components/layout.astro";
import Mermaid from "@/components/Mermaid.astro";
import "@/styles/global.css";

const nav = [
	{ href: "/", label: "Docs" },
	{ href: "/visualize", label: "Visualize" },
	{ href: "/visualize/cli", label: "CLI" },
	{ href: "/visualize/machine", label: "Machine" },
	{ href: "/visualize/contract-machine-server", label: "M↔S" },
	{ href: "/visualize/contract-server-web", label: "S↔W" },
	{ href: "/visualize/architecture", label: "Arch" },
];

const commands = [
	{
		doc: "/cli/enroll",
		exit: "0 / 1",
		name: "enroll",
		out: "identity.json + limits.json + state.db",
		usage: "enroll --server <url> [--name] [--systemd] [--client-id]",
	},
	{
		doc: "/cli/daemon",
		exit: "0 / 3",
		name: "daemon",
		out: "WS client + heartbeat tick",
		usage: "daemon [--interval <s>]",
	},
	{
		doc: "/cli/check",
		exit: "0 / 2",
		name: "check",
		out: "drift table",
		usage: "check [--only] [--json]",
	},
	{
		doc: "/cli/reset",
		exit: "0 / 2 / 1",
		name: "reset",
		out: "receipts / worktree clean",
		usage:
			"reset [--only] [--dry-run] [--prune] | reset --fresh-start --sandbox",
	},
	{
		doc: "/cli/sync",
		exit: "0 / 2",
		name: "sync",
		out: "jobId + receipts → SQLite",
		usage: "sync [--dry-run] [--json] [--only]",
	},
	{
		doc: "/cli/history",
		exit: "0",
		name: "history",
		out: "heartbeat table",
		usage: "history [--range] [--json]",
	},
	{
		doc: "/cli/sandbox",
		exit: "0 / 1",
		name: "sandbox",
		out: "inventory / prune stopped",
		usage: "sandbox [list|prune] [--json] [--dry-run]",
	},
	{
		doc: "/cli/run",
		exit: "0 / 1",
		name: "run",
		out: "manual assign → status",
		usage:
			"run --task <id> [--prompt] [--project] [--repo] [--commit] [--branch] [--agent] [--fresh]",
	},
];

const chart = `flowchart TD
    root["uma-machine"] --> c1["enroll"]
    root --> c2["daemon"]
    root --> c3["check"]
    root --> c4["reset"]
    root --> c5["sync"]
    root --> c6["history"]
    root --> c7["sandbox"]
    root --> c8["run"]
    root --> c9["version plus help"]
    c4 --> r1["default: resetAll to receipts"]
    c4 --> r2["fresh-start: git clean plus reset hard"]
    c7 --> s1["list: inventory table"]
    c7 --> s2["prune: remove stopped"]`;

const ascii = `uma-machine ─┬─ enroll ──→ POST /device/code → poll /device/token → identity.json
           ├─ daemon ──→ ws://server/api/machines/ws + heartbeat tick
           ├─ check ───→ checkAll() ──→ table (exit 2 if drifted)
           ├─ reset ──┬─ (default) resetAll() ──→ receipts
           │         └─ --fresh-start ──→ git clean -fdx + reset --hard
           ├─ sync ────→ performSync() ──→ SQLite receipts (jobId local-*)
           ├─ history ─→ readHistory(range) ──→ table
           ├─ sandbox ┬─ list ──→ inventory table
           │         └─ prune ─→ remove stopped
           ├─ run ─────→ executeTask(manual assign) ──→ completed|failed|refused|rejected
           ├─ version ─→ uma-machine 0.1.0 (protocol v1)
           └─ help ────→ helpText() + Keys + Exit codes`;
---
<Layout>
  <title>Visualize CLI — UMA</title>
  <div class="min-h-screen bg-fd-background text-fd-foreground">
    <header class="border-b border-fd-border">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-1 px-4 py-3 text-sm">
        {nav.map((n) => (
          <a href={n.href} class="rounded-md px-2.5 py-1.5 text-fd-muted-foreground hover:bg-fd-accent hover:text-fd-accent-foreground">{n.label}</a>
        ))}
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-10">
      <p class="text-sm font-medium text-fd-muted-foreground">visualize/cli · source: apps/machine/src/cli.ts, index.ts</p>
      <h1 class="mt-1 text-3xl font-semibold">CLI command tree</h1>
      <p class="mt-2 max-w-2xl text-fd-muted-foreground">Every <code>uma-machine</code> command, its usage shape, output, and exit codes. Detail pages linked per card.</p>

      <Mermaid chart={chart} ascii={ascii} />

      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {commands.map((c) => (
          <div class="rounded-xl border border-fd-border bg-fd-card p-5">
            <div class="flex items-center justify-between gap-2">
              <h2 class="font-mono font-semibold">uma-machine {c.name}</h2>
              <a href={c.doc} class="text-sm text-fd-primary hover:underline">docs →</a>
            </div>
            <p class="mt-2 font-mono text-xs text-fd-muted-foreground">{c.usage}</p>
            <div class="mt-3 grid grid-cols-2 gap-2 text-sm">
              <div class="rounded-md bg-fd-accent/50 p-2"><span class="text-xs text-fd-muted-foreground">output</span><br/>{c.out}</div>
              <div class="rounded-md bg-fd-accent/50 p-2"><span class="text-xs text-fd-muted-foreground">exit</span><br/><span class="font-mono">{c.exit}</span></div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-3 text-sm">
        <div class="rounded-xl border border-fd-border p-4"><h3 class="font-semibold">Keys (--only)</h3><p class="mt-1 font-mono text-xs">programs, git-login, adityab-agent, agents, files, providers, mcp, skills, systemd</p></div>
        <div class="rounded-xl border border-fd-border p-4"><h3 class="font-semibold">Exits</h3><p class="mt-1 font-mono text-xs">0 ok · 2 drifted/partial · 1 error · 3 UPGRADE_REQUIRED</p></div>
        <div class="rounded-xl border border-fd-border p-4"><h3 class="font-semibold">Global flags</h3><p class="mt-1 font-mono text-xs">-h/--help · -v/--version · --json · --dry-run</p></div>
      </div>
    </main>
  </div>
</Layout>
