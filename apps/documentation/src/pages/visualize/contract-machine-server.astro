---
import Layout from "@/components/layout.astro";
import "@/styles/global.css";

const nav = [
	{ href: "/", label: "Docs" },
	{ href: "/visualize", label: "Visualize" },
	{ href: "/visualize/cli", label: "CLI" },
	{ href: "/visualize/machine", label: "Machine" },
	{ href: "/visualize/contract-machine-server", label: "M↔S" },
	{ href: "/visualize/contract-server-web", label: "S↔W" },
	{ href: "/visualize/architecture", label: "Arch" },
];

const m2s = [
	{
		fields:
			"cliVersion, configVersion, metrics, quotaUsage, sandboxes[], scopeHint",
		t: "heartbeat",
	},
	{ fields: "taskId, chunk ≤256KB UTF-8 bytes, stream?", t: "log" },
	{
		fields: "taskId, completed|failed, projectId, result? ≤64k",
		t: "task-done",
	},
	{ fields: "taskId, sandboxId, ok, error?", t: "claim-ack" },
	{
		fields: "taskId, limits, usage (paired with claim-ack❌)",
		t: "quota-exceeded",
	},
	{ fields: "jobId, key, ok, error? (× N keys)", t: "reset-ack" },
	{ fields: "jobId, receipts[] (only keys=*)", t: "sync-ack" },
	{ fields: "contract-only in v1 — never sent", t: "check-ack" },
];
const s2m = [
	{
		fields:
			"taskId, projectId, prompt, repoUrl, branch?, commit?, freshStart?, limits?",
		t: "assign",
	},
	{ fields: "taskId", t: "cancel" },
	{ fields: "jobId, keys[]|*, version, payload?", t: "reset-config" },
	{ fields: "minVersion, reason?", t: "UPGRADE_REQUIRED" },
];
---
<Layout>
  <title>Visualize machine↔server — UMA</title>
  <div class="min-h-screen bg-fd-background text-fd-foreground">
    <header class="border-b border-fd-border">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-1 px-4 py-3 text-sm">
        {nav.map((n) => (
          <a href={n.href} class="rounded-md px-2.5 py-1.5 text-fd-muted-foreground hover:bg-fd-accent hover:text-fd-accent-foreground">{n.label}</a>
        ))}
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-10">
      <p class="text-sm font-medium text-fd-muted-foreground">visualize/contract-machine-server · source: apps/orpc-contract/src/schemas/machine-frames.ts, schemas/server-frames.ts, contracts/ws.ts</p>
      <h1 class="mt-1 text-3xl font-semibold">oRPC contract: machine ↔ server</h1>
      <p class="mt-2 max-w-2xl text-fd-muted-foreground">Frozen <code>v1</code> raw-JSON frames at <code class="font-mono">/api/machines/ws</code> (not an oRPC envelope). Every machine→server frame carries <code class="font-mono">machineId + protocol:"v1"</code>. Detail: <a class="text-fd-primary hover:underline" href="/contracts/machine-server">/contracts/machine-server</a>.</p>

      <div class="mt-8 rounded-xl border border-fd-border bg-fd-card p-5 font-mono text-sm overflow-x-auto">
        <pre>{`machine ── ws(s):///api/machines/ws (Bearer, protocol v1) ── server
   │  heartbeat (30s) ──────────────────────────────▶  │
   │  log / task-done / claim-ack / quota-exceeded ──▶  │
   │  reset-ack* / sync-ack ────────────────────────▶  │
   │  ◀────────────────────── assign / cancel ───────  │
   │  ◀──────────────── reset-config / UPGRADE_REQ ──  │`}</pre>
      </div>

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div>
          <h2 class="text-lg font-semibold">Machine → server (8)</h2>
          <div class="mt-3 flex flex-col gap-2">
            {m2s.map((f) => (
              <div class="rounded-lg border border-fd-border bg-fd-card p-3">
                <span class="font-mono text-sm font-semibold text-green-600 dark:text-green-400">▲ {f.t}</span>
                <p class="mt-1 font-mono text-xs text-fd-muted-foreground">{f.fields}</p>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h2 class="text-lg font-semibold">Server → machine (4)</h2>
          <div class="mt-3 flex flex-col gap-2">
            {s2m.map((f) => (
              <div class="rounded-lg border border-fd-border bg-fd-card p-3">
                <span class="font-mono text-sm font-semibold text-blue-600 dark:text-blue-400">▼ {f.t}</span>
                <p class="mt-1 font-mono text-xs text-fd-muted-foreground">{f.fields}</p>
              </div>
            ))}
          </div>
          <h2 class="mt-6 text-lg font-semibold">Device + claim HTTPS</h2>
          <div class="mt-3 flex flex-col gap-2 font-mono text-xs">
            <div class="rounded-lg border border-fd-border bg-fd-card p-3">POST /device/code → POST /device/token<br/><span class="text-fd-muted-foreground">user_code approval, Bearer session</span></div>
            <div class="rounded-lg border border-fd-border bg-fd-card p-3">POST /api/rpc/machines/claim {"{machineId, sandboxId, taskId}"}<br/><span class="text-fd-muted-foreground">409 = someone else won → free sandbox</span></div>
          </div>
        </div>
      </div>
      <p class="mt-6 text-sm text-fd-muted-foreground">Parsers: <code class="font-mono">validateMachineFrame</code> (outbound, throws) · <code class="font-mono">parseServerFrame</code> (inbound, unknown t → null). Registry: <code class="font-mono">wsMessagesContract</code> in contracts/ws.ts.</p>
    </main>
  </div>
</Layout>
