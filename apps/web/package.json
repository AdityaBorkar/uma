{
	"name": "@uma/web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "vite build",
		"check:env": "bun run scripts/check-env.ts",
		"check:lint": "biome check --fix .",
		"check:types": "tsc --noEmit",
		"clean": "bunx rimraf --glob \"**/{node_modules,.output,.local,.tanstack,.wrangler,bun.lockb}\"",
		"db:push": "bun run:dev -- drizzle-kit push",
		"db:studio": "bun run:dev -- drizzle-kit studio",
		"dev": "bun run:dev -- vite dev --port 3000",
		"gen:auth-schema": "bun run:dev -- bunx auth generate --config ./src/lib/auth/server.ts --output ./src/schemas/db/auth.gen.ts",
		"gen:routes": "tsr generate",
		"infra:destroy": "pulumi destroy --stack",
		"infra:prepare": "bun run:dev -- bun ./scripts/prepare-infra.ts",
		"infra:preview": "pulumi preview --stack",
		"infra:refresh": "pulumi refresh --stack",
		"infra:up": "pulumi up --stack",
		"prepare": "husky",
		"preview": "bun run:dev -- vite preview",
		"run:dev": "bun ./infra/utils/run-command.ts --verbose --stack dev",
		"seed:user": "bun run:dev -- bun ./scripts/seed/user.ts",
		"update-deps": "bun update --latest && bun install"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.0",
		"@hugeicons/react": "^1.1.10",
		"@mdx-js/mdx": "^3.1.1",
		"@orpc/client": "^1.15.0",
		"@orpc/json-schema": "^1.15.0",
		"@orpc/openapi": "^1.15.0",
		"@orpc/server": "^1.15.0",
		"@orpc/tanstack-query": "^1.15.0",
		"@orpc/zod": "^1.15.0",
		"@posthog/react": "^1.10.5",
		"@pulumi/local": "^0.1.6",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-router-ssr-query": "^1.167.2",
		"@tanstack/react-start": "^1.168.49",
		"@tiptap/extension-link": "^3.31.3",
		"@tiptap/extension-list": "^3.31.3",
		"@tiptap/extension-table": "^3.31.3",
		"@tiptap/extensions": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"better-auth": "^1.7.3",
		"bun": "^1.4.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"gray-matter": "^4.0.3",
		"hast-util-sanitize": "^5.0.2",
		"nitro": "3.0.260903-beta",
		"pg": "^8.23.0",
		"posthog-js": "^1.427.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"rehype-parse": "^9.0.1",
		"rehype-remark": "^10.0.1",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remark-stringify": "^11.0.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"unified": "^11.0.5",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@clack/prompts": "^1.7.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-event-client": "^0.5.0",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/react-devtools": "^0.10.12",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/router-cli": "^1.167.33",
		"@types/bun": "^1.4.1",
		"@types/node": "^26.4.1",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"commander": "^15.0.0",
		"commitlint": "^21.2.2",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"react-doctor": "^0.9.13",
		"react-grab": "^0.2.0",
		"react-scan": "^0.5.7",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "^8.2.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	}
}
